# URL de base de l'API n8n (server-to-server, pas besoin de CORS ici)
N8N_BASE_URL=https://n8n.example.com/api/v1

# Origine autorisée pour les appels CORS depuis la PWA
ALLOWED_ORIGIN=https://monnhuitne.example.com

PORT=8787

# Générées une fois avec `npx web-push generate-vapid-keys` puis figées ici.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Fréquence du sondage de fallback (minutes) pour /health/summary et la détection d'échecs
HEALTH_POLL_INTERVAL_MINUTES=10

# Nombre de jours d'inactivité au delà duquel un workflow actif est considéré "stale"
STALE_WORKFLOW_DAYS=7

# Fichier de persistance des abonnements push (JSON simple, pas de DB pour rester minimal)
SUBSCRIPTIONS_FILE=./data/subscriptions.json
